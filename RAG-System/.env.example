GEMINI_API_KEY=your_api_key_here
API_KEYS=change-me-api-key
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LLM_MODEL=gemini-2.5-flash
